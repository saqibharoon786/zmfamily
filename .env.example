# Contact form emails go to zmfamilykitchen@gmail.com automatically via FormSubmit.
# No setup required for local development — just run: npm run dev
#
# IMPORTANT: On the FIRST form submission, FormSubmit sends a verification email
# to zmfamilykitchen@gmail.com. Open that email and click "Activate Form" once.
# After that, all form submissions arrive in your inbox.
#
# Optional — Gmail SMTP (overrides FormSubmit when SMTP_PASS is set):
# SMTP_USER=zmfamilykitchen@gmail.com
# SMTP_PASS=your-16-char-google-app-password

CONTACT_EMAIL_TO=zmfamilykitchen@gmail.com
